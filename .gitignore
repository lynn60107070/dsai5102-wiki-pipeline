paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.fdb_latexmk
paper/*.fls

# editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# sample-data mode: a few real hours of the clean zone, committed on purpose (scripts/make_sample.py)
!sample/**/*.parquet
