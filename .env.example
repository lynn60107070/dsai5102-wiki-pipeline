# Copy this file to .env (never commit .env).

# Wikimedia asks every API client to identify itself with a name and a contact URL.
WIKI_USER_AGENT=dsai5102-wiki-pipeline/0.1 (https://github.com/lynn60107070/dsai5102-wiki-pipeline; student project)

# Data lake (MinIO) login, used by the services and the web console at http://localhost:9001.
# Local only; the password must be at least 8 characters.
MINIO_ROOT_USER=lakeadmin
MINIO_ROOT_PASSWORD=change-me-lake-123

# Postgres (Airflow metadata now, dashboard tables in L6). Local only.
POSTGRES_PASSWORD=change-me-postgres-123

# Airflow web UI login (http://localhost:8080).
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-airflow-123

# How often the raw sink writes its buffered events to files (seconds). 300 = one file per hour folder every 5 min.
FLUSH_SECONDS=300
